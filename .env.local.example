# Next.js Public Storefront Configuration
# Do NOT place real secrets in this file. Copy this to .env.local and fill in the values.

# -----------------------------------------------------------------------------
# COMMERCE ABSTRACTION LAYER CONFIG
# We currently use a mock backend while in development. Once you decide between
# Shopify Headless or Medusa, you will use the appropriate keys below.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_COMMERCE_PROVIDER="mock" # Set to "shopify" or "medusa" later

# --- If you choose Shopify Headless ---
# NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
# NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN="your_storefront_access_token_here"

# --- If you choose Medusa.js ---
# NEXT_PUBLIC_MEDUSA_BACKEND_URL="http://localhost:9000"
# NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY="pk_..."
