# Awaraa's Culture — Environment Variable Template
# Branch: explore/bright-genre (Supabase + Sanity + Next.js)
# DO NOT place real secrets in this file.
# Copy to .env.local and fill in the real values. Never commit .env.local.

# -----------------------------------------------------------------------------
# COMMERCE PROVIDER
# Set to "supabase-sanity" on this branch (explore/bright-genre).
# The main branch uses "shopify". Do not mix these.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_COMMERCE_PROVIDER="supabase-sanity"

# -----------------------------------------------------------------------------
# SUPABASE (Auth + Database)
# Get these from: https://supabase.com/dashboard → your project → Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your_supabase_anon_key_here"
# The service role key is ONLY for server-side admin operations (e.g., seeding).
# Never expose this client-side. Never commit this.
# SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"

# -----------------------------------------------------------------------------
# SANITY (Product CMS)
# Get these from: https://sanity.io/manage → your project → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID="your_sanity_project_id"
NEXT_PUBLIC_SANITY_DATASET="production"
# API token with read permissions for server-side fetches.
SANITY_API_TOKEN="your_sanity_api_token_here"

# Write token — Editor or Developer role. Required for inventory mutations and order creation.
# Used by the import script AND by the live inventory management system.
# Must NEVER be prefixed NEXT_PUBLIC_ and must NEVER be imported into client-side code.
# Get it from: https://sanity.io/manage -> your project -> API -> Tokens
SANITY_WRITE_TOKEN="skXXXXXXXXXXX..."

# -----------------------------------------------------------------------------
# ADMIN ACCESS
# Comma-separated list of email addresses allowed to access /admin dashboard.
# Must be a Supabase Auth user. Case-insensitive.
# Example: ADMIN_EMAIL="owner@example.com,manager@example.com"
# -----------------------------------------------------------------------------
ADMIN_EMAIL="your-admin-email@example.com"

# Low stock threshold — variants with stock at or below this number show "LOW STOCK".
# Defaults to 3 if not set.
# LOW_STOCK_THRESHOLD="3"

# -----------------------------------------------------------------------------
# RAZORPAY (Payments — Phase 5)
# Get these from: https://dashboard.razorpay.com → Settings → API Keys
# Use TEST mode keys until Phase 5 is reviewed and approved.
# The secret key MUST remain server-only — never prefix with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------
# RAZORPAY_KEY_ID="rzp_test_your_key_id"
# RAZORPAY_KEY_SECRET="your_razorpay_secret_here"

# -----------------------------------------------------------------------------
# UPSTASH REDIS (Rate limiting — Phase 6)
# Get these from: https://console.upstash.com → your Redis database → REST API
# -----------------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your_upstash_token_here"

# -----------------------------------------------------------------------------
# INSTAGRAM ORDERING
# Official Awaraa's Culture Instagram username without the @ prefix.
# Used for direct DM links and order routing.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_INSTAGRAM_USERNAME="awaraas_culture"

# -----------------------------------------------------------------------------
# SITE
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
